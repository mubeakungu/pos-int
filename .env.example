# Copy to .env for local development. Never commit real values.
DATABASE_URL=sqlite:///pos.db
SECRET_KEY=change-me
ADMIN_PASSWORD=change-me

# Public HTTPS address of this POS, used to build callback URLs for M-Pesa etc.
PUBLIC_BASE_URL=https://your-pos.example.com

# --- M-Pesa Daraja (https://developer.safaricom.co.ke) ---
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
# Optional: random string appended to the callback URL as ?token=...
MPESA_CALLBACK_TOKEN=
# Optional override of the shortcode set on the Integrations page
# MPESA_SHORTCODE=174379

# --- KRA eTIMS (OSCU) ---
# ETIMS_TIN=P000000000A
# ETIMS_BHF_ID=00
# ETIMS_DEVICE_SERIAL=
ETIMS_CMC_KEY=

# --- Your own integrations: reference these from webhook headers as ${MY_API_KEY} ---
# MY_API_KEY=
